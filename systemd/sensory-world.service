[Unit]
Description=Sensory World server
After=network.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=/home/REPLACE_USER/bubbleworld
ExecStart=/home/REPLACE_USER/bubbleworld/.venv/bin/python /home/REPLACE_USER/bubbleworld/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
